# Supabase（只在伺服器端使用 service role key，絕不可加 NEXT_PUBLIC_）
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LINE Login channel / LIFF
NEXT_PUBLIC_LIFF_ID=1234567890-AbCdEfGh
LINE_CHANNEL_ID=1234567890

# 自家 session 簽章密鑰（至少 32 字元隨機字串）
SESSION_SECRET=

# 初始管理員 LINE userId（逗號分隔；僅在 admins 表為空時寫入）
INITIAL_ADMIN_USER_IDS=Uadmin0000000000000000000000000001

# Vercel Cron 驗證（Vercel 會自動帶 Authorization: Bearer <CRON_SECRET>）
CRON_SECRET=

# 本機開發：略過 LIFF，使用 /dev-login 以假身分登入（production 無效）
DEV_MOCK_LOGIN=true
